@prefix ex: <http://example.org/med#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sym: <http://example.org/med#symptom/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/med#hardTriggerLabel
ex:hardTriggerLabel rdf:type owl:ObjectProperty ;
                    rdfs:domain ex:AlarmSymptom ;
                    rdfs:range ex:TriageLabel .


###  http://example.org/med#hasPrimarySymptom
ex:hasPrimarySymptom rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ex:hasSymptom ;
                     rdfs:domain ex:Disease ;
                     rdfs:range ex:Symptom .


###  http://example.org/med#hasRareSymptom
ex:hasRareSymptom rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf ex:hasSymptom ;
                  rdfs:domain ex:Disease ;
                  rdfs:range ex:Symptom .


###  http://example.org/med#hasReportedSymptom
ex:hasReportedSymptom rdf:type owl:ObjectProperty ;
                      rdfs:domain ex:Case ;
                      rdfs:range ex:Symptom ;
                      rdfs:label "has reported symptom"@en .


###  http://example.org/med#hasSecondarySymptom
ex:hasSecondarySymptom rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf ex:hasSymptom ;
                       rdfs:domain ex:Disease ;
                       rdfs:range ex:Symptom .


###  http://example.org/med#hasSymptom
ex:hasSymptom rdf:type owl:ObjectProperty ;
              owl:inverseOf ex:isSymptomOf ;
              rdfs:domain ex:Disease ;
              rdfs:range ex:Symptom .


###  http://example.org/med#isSymptomOf
ex:isSymptomOf rdf:type owl:ObjectProperty ;
               rdfs:domain ex:Symptom ;
               rdfs:range ex:Disease ;
               rdfs:label "is symptom of"@en .


###  http://example.org/med#triageLabel
ex:triageLabel rdf:type owl:ObjectProperty ;
               rdfs:domain ex:TriageRule ;
               rdfs:range ex:TriageLabel .


###  http://example.org/med#triageResult
ex:triageResult rdf:type owl:ObjectProperty ;
                rdfs:domain ex:Case ;
                rdfs:range ex:TriageLabel ;
                rdfs:label "triage result"@en .


#################################################################
#    Data properties
#################################################################

###  http://example.org/med#alarm
ex:alarm rdf:type owl:DatatypeProperty ;
         rdfs:domain ex:AlarmSymptom ;
         rdfs:range rdfs:Literal .


###  http://example.org/med#hasExplanation
ex:hasExplanation rdf:type owl:DatatypeProperty ;
                  rdfs:domain ex:Disease ;
                  rdfs:range rdfs:Literal .


###  http://example.org/med#painScale
ex:painScale rdf:type owl:DatatypeProperty ;
             rdfs:domain ex:Case ;
             rdfs:range xsd:decimal ;
             rdfs:label "pain scale (0-10)"@en .


###  http://example.org/med#scorePoints
ex:scorePoints rdf:type owl:DatatypeProperty ;
               rdfs:domain ex:Symptom ;
               rdfs:range xsd:integer .


###  http://example.org/med#scoreThreshold
ex:scoreThreshold rdf:type owl:DatatypeProperty ;
                  rdfs:domain ex:TriageRule ;
                  rdfs:range xsd:integer .


###  http://example.org/med#seeDoctor
ex:seeDoctor rdf:type owl:DatatypeProperty ;
             rdfs:domain ex:Disease ;
             rdfs:range rdfs:Literal .


###  http://example.org/med#systolicBP
ex:systolicBP rdf:type owl:DatatypeProperty ;
              rdfs:domain ex:Case ;
              rdfs:range xsd:decimal ;
              rdfs:label "systolic blood pressure (mmHg)"@en .


###  http://example.org/med#temperatureC
ex:temperatureC rdf:type owl:DatatypeProperty ;
                rdfs:domain ex:Case ;
                rdfs:range xsd:decimal ;
                rdfs:label "temperature (C)"@en .


###  http://example.org/med#threshold
ex:threshold rdf:type owl:DatatypeProperty ;
             rdfs:domain ex:AlarmSymptom ;
             rdfs:range xsd:decimal .


###  http://example.org/med#thresholdComparator
ex:thresholdComparator rdf:type owl:DatatypeProperty ;
                       rdfs:domain ex:AlarmSymptom ;
                       rdfs:range xsd:string .


###  http://example.org/med#thresholdUnit
ex:thresholdUnit rdf:type owl:DatatypeProperty ;
                 rdfs:domain ex:AlarmSymptom ;
                 rdfs:range xsd:string .


###  http://example.org/med#treatment
ex:treatment rdf:type owl:DatatypeProperty ;
             rdfs:domain ex:Disease ;
             rdfs:range rdfs:Literal .


#################################################################
#    Classes
#################################################################

###  http://example.org/med#AlarmSymptom
ex:AlarmSymptom rdf:type owl:Class ;
                rdfs:subClassOf ex:Symptom ;
                rdfs:label "Alarm Symptom"@en .


###  http://example.org/med#CardiovascularSymptom
ex:CardiovascularSymptom rdf:type owl:Class ;
                         rdfs:subClassOf ex:Symptom ;
                         owl:disjointWith ex:ClinicalFinding ,
                                          ex:GastrointestinalSymptom ,
                                          ex:GeneralSymptom ,
                                          ex:NeurologicalSymptom ,
                                          ex:RespiratorySymptom ,
                                          ex:SkinSymptom ,
                                          ex:SystemicSymptom .


###  http://example.org/med#Case
ex:Case rdf:type owl:Class ;
        rdfs:label "Case"@en .


###  http://example.org/med#ClinicalFinding
ex:ClinicalFinding rdf:type owl:Class ;
                   rdfs:subClassOf ex:Symptom ;
                   owl:disjointWith ex:GastrointestinalSymptom ,
                                    ex:GeneralSymptom ,
                                    ex:NeurologicalSymptom ,
                                    ex:RespiratorySymptom ,
                                    ex:SkinSymptom ,
                                    ex:SystemicSymptom .


###  http://example.org/med#Disease
ex:Disease rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty ex:hasPrimarySymptom ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass ex:Symptom
                           ] ;
           rdfs:label "Disease"@en .


###  http://example.org/med#Explanation
ex:Explanation rdf:type owl:Class ;
               rdfs:label "Explanation"@en .


###  http://example.org/med#GastrointestinalSymptom
ex:GastrointestinalSymptom rdf:type owl:Class ;
                           rdfs:subClassOf ex:Symptom ;
                           owl:disjointWith ex:GeneralSymptom ,
                                            ex:NeurologicalSymptom ,
                                            ex:RespiratorySymptom ,
                                            ex:SkinSymptom ,
                                            ex:SystemicSymptom .


###  http://example.org/med#GeneralSymptom
ex:GeneralSymptom rdf:type owl:Class ;
                  rdfs:subClassOf ex:Symptom ;
                  owl:disjointWith ex:NeurologicalSymptom ,
                                   ex:RespiratorySymptom ,
                                   ex:SkinSymptom ,
                                   ex:SystemicSymptom .


###  http://example.org/med#NeurologicalSymptom
ex:NeurologicalSymptom rdf:type owl:Class ;
                       rdfs:subClassOf ex:Symptom ;
                       owl:disjointWith ex:RespiratorySymptom ,
                                        ex:SkinSymptom ,
                                        ex:SystemicSymptom .


###  http://example.org/med#RespiratorySymptom
ex:RespiratorySymptom rdf:type owl:Class ;
                      rdfs:subClassOf ex:Symptom ;
                      owl:disjointWith ex:SkinSymptom ,
                                       ex:SystemicSymptom .


###  http://example.org/med#SkinSymptom
ex:SkinSymptom rdf:type owl:Class ;
               rdfs:subClassOf ex:Symptom ;
               owl:disjointWith ex:SystemicSymptom .


###  http://example.org/med#Symptom
ex:Symptom rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Class ;
                                 owl:unionOf ( ex:AlarmSymptom
                                               ex:CardiovascularSymptom
                                               ex:GastrointestinalSymptom
                                               ex:GeneralSymptom
                                               ex:NeurologicalSymptom
                                               ex:RespiratorySymptom
                                               ex:SkinSymptom
                                               ex:SystemicSymptom
                                             )
                               ] ;
           rdfs:label "Symptom"@en .


###  http://example.org/med#SystemicSymptom
ex:SystemicSymptom rdf:type owl:Class ;
                   rdfs:subClassOf ex:Symptom .


###  http://example.org/med#TriageLabel
ex:TriageLabel rdf:type owl:Class ;
               rdfs:label "Triage Label"@en .


###  http://example.org/med#TriageRule
ex:TriageRule rdf:type owl:Class ;
              rdfs:label "Triage Rule"@en .


#################################################################
#    Individuals
#################################################################

###  http://example.org/med#adultTriageRule
ex:adultTriageRule rdf:type owl:NamedIndividual ,
                            ex:TriageRule ;
                   ex:triageLabel ex:urgent ;
                   ex:scoreThreshold 5 ;
                   rdfs:label "Adult triage scoring rule"@en .


###  http://example.org/med#alarmMessage
ex:alarmMessage rdf:type owl:NamedIndividual ;
                ex:alarm "Please contact your GP Immediately!"@en .


###  http://example.org/med#emergency
ex:emergency rdf:type owl:NamedIndividual ,
                      ex:TriageLabel ;
             rdfs:label "emergency"@en .


###  http://example.org/med#routine
ex:routine rdf:type owl:NamedIndividual ,
                    ex:TriageLabel ;
           rdfs:label "routine"@en .


###  http://example.org/med#unclear
ex:unclear rdf:type owl:NamedIndividual ,
                    ex:TriageLabel ;
           rdfs:label "unclear"@en .


###  http://example.org/med#urgent
ex:urgent rdf:type owl:NamedIndividual ,
                   ex:TriageLabel ;
          rdfs:label "urgent"@en .


###  http://example.org/med#symptom/aching_legs
sym:aching_legs rdf:type owl:NamedIndividual ,
                         ex:SystemicSymptom ;
                skos:prefLabel "aching legs"@en .


###  http://example.org/med#symptom/breathing_problems
sym:breathing_problems rdf:type owl:NamedIndividual ,
                                ex:AlarmSymptom ;
                       ex:hardTriggerLabel ex:emergency ;
                       skos:closeMatch wd:Q188008 ;
                       skos:prefLabel "breathing problems"@en .


###  http://example.org/med#symptom/bulging_blue_veins
sym:bulging_blue_veins rdf:type owl:NamedIndividual ,
                                ex:CardiovascularSymptom ;
                       skos:prefLabel "bulging blue veins"@en .


###  http://example.org/med#symptom/change_mental_status
sym:change_mental_status rdf:type owl:NamedIndividual ,
                                  ex:AlarmSymptom ;
                         ex:hardTriggerLabel ex:emergency ;
                         skos:closeMatch wd:Q557945 ;
                         skos:prefLabel "change in mental status (confusion, unusual behavior, hard to wake)"@en .


###  http://example.org/med#symptom/chest_pain_2min
sym:chest_pain_2min rdf:type owl:NamedIndividual ,
                             ex:AlarmSymptom ;
                    ex:hardTriggerLabel ex:emergency ;
                    skos:closeMatch wd:Q693058 ;
                    skos:prefLabel "chest pain or discomfort lasting two minutes or more"@en .


###  http://example.org/med#symptom/coughing_blood
sym:coughing_blood rdf:type owl:NamedIndividual ,
                            ex:AlarmSymptom ;
                   ex:hardTriggerLabel ex:emergency ;
                   skos:closeMatch wd:Q647099 ;
                   skos:prefLabel "coughing up blood"@en .


###  http://example.org/med#symptom/disconfort_sitting
sym:disconfort_sitting rdf:type owl:NamedIndividual ,
                                ex:GeneralSymptom ;
                       skos:prefLabel "disconfort by sitting"@en .


###  http://example.org/med#symptom/extreme_pain
sym:extreme_pain rdf:type owl:NamedIndividual ,
                          ex:AlarmSymptom ;
                 ex:hardTriggerLabel ex:emergency ;
                 ex:threshold 9 ;
                 ex:thresholdComparator ">=" ;
                 ex:thresholdUnit "0-10" ;
                 rdfs:label "extreme pain"@en ;
                 skos:closeMatch wd:Q81938 .


###  http://example.org/med#symptom/face_tongue_swelling
sym:face_tongue_swelling rdf:type owl:NamedIndividual ,
                                  ex:AlarmSymptom ;
                         ex:hardTriggerLabel ex:emergency ;
                         skos:closeMatch wd:Q109186 ;
                         skos:prefLabel "swelling of face, eyes, or tongue"@en .


###  http://example.org/med#symptom/feeling_incomplete_bowel_emptying
sym:feeling_incomplete_bowel_emptying rdf:type owl:NamedIndividual ,
                                               ex:GastrointestinalSymptom ;
                                      skos:prefLabel "feeling of incomplete bowel emptying"@en .


###  http://example.org/med#symptom/high_blood_pressure
sym:high_blood_pressure rdf:type owl:NamedIndividual ,
                                 ex:AlarmSymptom ;
                        ex:hardTriggerLabel ex:emergency ;
                        ex:threshold 180 ;
                        ex:thresholdComparator ">=" ;
                        ex:thresholdUnit "mmHg_systolic" ;
                        rdfs:label "high blood pressure"@en .


###  http://example.org/med#symptom/high_temprature
sym:high_temprature rdf:type owl:NamedIndividual ,
                             ex:AlarmSymptom ;
                    ex:hardTriggerLabel ex:emergency ;
                    ex:threshold 40 ;
                    ex:thresholdComparator ">=" ;
                    ex:thresholdUnit "C" ;
                    rdfs:label "high body temprature"@en ;
                    skos:closeMatch wd:Q38933 .


###  http://example.org/med#symptom/honey_colored_crust
sym:honey_colored_crust rdf:type owl:NamedIndividual ,
